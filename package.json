{
  "name": "arco",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/my-name-is-yu/Arco.git"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "npm run build && node scripts/dev-host.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests vite.config.ts playwright.config.ts",
    "format": "prettier --write src scripts tests *.json *.ts *.js README.md",
    "format:check": "prettier --check src scripts tests *.json *.ts *.js README.md",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "vitest run --exclude '**/*browser.spec.ts'",
    "build": "vite build && node scripts/build-server.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check:artifact": "node scripts/check-artifact.mjs",
    "check:package": "node scripts/check-package.mjs",
    "package:plugin": "npm run build && npm run check:artifact && npm run check:package",
    "test:browser": "playwright test",
    "test:browser:smoke": "playwright test --grep @smoke",
    "dev:fixture": "node scripts/dev-host.mjs",
    "test:live": "node scripts/validate-live.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:docs && npm test && npm run build && npm run smoke && npm run check:artifact && npm run check:package"
  },
  "dependencies": {
    "@linear/sdk": "99.0.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/keyring": "2.1.2",
    "@openai/apps-sdk-ui": "0.2.2",
    "@openai/mcp-extensions": "0.2.1",
    "@tanstack/react-query": "5.104.5",
    "mdast-util-from-markdown": "2.1.0",
    "proper-lockfile": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-sanitize": "6.0.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "acorn": "8.17.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@openai/mcp-extensions": {
      "zod": "$zod"
    },
    "@openai/apps-sdk-ui": {
      "lodash": "4.18.1",
      "katex": "0.18.2"
    }
  }
}
