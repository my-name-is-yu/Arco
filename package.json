{
  "name": "arco",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "npm run build && node scripts/dev-host.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests vite.config.ts",
    "format": "prettier --write src scripts tests *.json *.ts *.js README.md",
    "format:check": "prettier --check src scripts tests *.json *.ts *.js README.md",
    "test": "vitest run --exclude '**/*browser.spec.ts'",
    "build": "vite build && node scripts/build-server.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check:artifact": "node scripts/check-artifact.mjs",
    "test:browser": "playwright test",
    "dev:fixture": "node scripts/dev-host.mjs",
    "test:live": "node scripts/validate-live.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run smoke && npm run check:artifact"
  },
  "dependencies": {
    "@linear/sdk": "99.0.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/keyring": "2.1.2",
    "@openai/apps-sdk-ui": "0.2.2",
    "@openai/mcp-extensions": "0.2.1",
    "@tanstack/react-query": "5.104.5",
    "mdast-util-from-markdown": "2.1.0",
    "proper-lockfile": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "acorn": "8.17.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  }
}
